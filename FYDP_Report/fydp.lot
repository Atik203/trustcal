\contentsline {table}{\numberline {3.1}{\ignorespaces Functional requirements and their verification. Gate-tested means the path runs without a GPU; paid-run evidence is still outstanding where marked.}}{12}{table.3.1}%
\contentsline {table}{\numberline {3.2}{\ignorespaces Arms and controls. Core v1.0 is the executable matrix; Full is the 32-row gold-evidence target (36-row gold-answer alternate) pending WP-18.}}{20}{table.3.2}%
\contentsline {table}{\numberline {3.3}{\ignorespaces Datasets and roles. SciClaimBench is a benchmark-freeze addition, not a Core v1.0 dataset.}}{21}{table.3.3}%
\contentsline {table}{\numberline {3.4}{\ignorespaces Project phases, dates, deliverables, and gates.}}{23}{table.3.4}%
\contentsline {table}{\numberline {3.5}{\ignorespaces Budget envelope. Core and Full share the 4-bit 24--27B matrix stack on one 80\,GB A100 spot; the 96\,GB FP8 stack is limited to the N1 smoke and precision replication.}}{24}{table.3.5}%
\contentsline {table}{\numberline {3.6}{\ignorespaces Module ownership across the six team members.}}{24}{table.3.6}%
